# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/leveled

# WHOOP credentials
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=https://localhost:3000/auth/whoop/callback
WHOOP_API_HOSTNAME=https://api.prod.whoop.com
WHOOP_WEBHOOK_SECRET=

# Security
# Generate with: npm run keys:generate
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=

# AI program builder (Claude). Set ANTHROPIC_MODEL to the latest Claude model id.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional: lock CORS to your client origin in production (default: *)
# CORS_ORIGIN=https://your-app.example

# Admin seed trigger (POST /admin/seed, header x-admin-key). Unset = endpoint always
# 403s. Set to any random string to enable, then unset/rotate after seeding if you
# want the endpoint closed again.
ADMIN_SEED_KEY=

# Server
PORT=3000
NODE_ENV=development

# HTTPS (local dev) — paths relative to backend/, generated via mkcert
TLS_CERT_PATH=certs/localhost.pem
TLS_KEY_PATH=certs/localhost-key.pem
